[safe]
	directory = /usr/local/Homebrew/Library/Taps/homebrew/homebrew-core
	directory = /usr/local/Homebrew/Library/Taps/homebrew/homebrew-cask
[core]
  pager = delta --paging=auto
	editor = nvim
[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
	dark = true
	syntax-theme = Monokai Extended Bright
	plus-style = syntax bold "#003f00"
	plus-emph-style = syntax bold "#005f00"
	minus-style = syntax bold "#4a0000"
	minus-emph-style = syntax bold "#7a0000"
	line-numbers-plus-style = bold "#80ff80"
	line-numbers-minus-style = bold "#ff8080"
[interactive]
	diffFilter = delta --color-only
[alias]
    st = status
    ci = commit
    cim = commit -m
    rehd = reset --hard
    resf = reset --soft
    cno = commit --amend --no-edit
    rbi = rebase -i
    rbc = rebase --continue
    lg = log --oneline --decorate -12 --color
    ll = log --pretty=format:\"%C(yellow) %h%Cred %ad%Cgreen%d%Creset %s %C(blue)[%an]%Creset\" --date=short
    lc = log --graph --color
    co = checkout
    br = branch
    mg = merge --log=9999
    d = difftool
